# syntax=docker/dockerfile:1
# Release image: offline-capable after build (all deps baked).
#
# Requires BuildKit named contexts `tome`, `imp` (imp-ts), and `imp-graph-view`.
# Each may be a local folder or a git URL (`https://github.com/<owner>/<repo>.git#<ref>`).
# Prefer: bash docker/build-release.sh

FROM debian:bookworm-slim AS base
ENV BUN_INSTALL=/usr/local/bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"
ENV DEBIAN_FRONTEND=noninteractive
COPY docker/install-runtime.sh /tmp/install-runtime.sh
RUN bash /tmp/install-runtime.sh && rm /tmp/install-runtime.sh

# Full sources, normalized so a local folder and a git URL yield the same tree:
# no host node_modules (bake-deps installs fresh) and no .git (git URL contexts have none).
FROM base AS sources
COPY --from=tome . /opt/tome
COPY --from=imp . /opt/imp-ts
COPY --from=imp-graph-view . /opt/imp-graph-view
RUN find /opt/tome /opt/imp-ts /opt/imp-graph-view \
      \( -name node_modules -o -name .git \) -prune -exec rm -rf {} +

# Install inputs only (package.json files, lockfiles, bunfig). A source-only change
# leaves this tree byte-identical, so the install layer below stays cached.
FROM sources AS manifests
RUN find /opt/tome /opt/imp-ts /opt/imp-graph-view -type f \
      ! -name package.json ! -name bun.lock ! -name bunfig.toml -delete \
  && find /opt/tome /opt/imp-ts /opt/imp-graph-view -mindepth 1 -type d -empty -delete

FROM base AS deps
WORKDIR /opt
COPY --from=manifests /opt/tome /opt/tome
COPY --from=manifests /opt/imp-ts /opt/imp-ts
COPY --from=manifests /opt/imp-graph-view /opt/imp-graph-view
COPY docker/bake-deps.sh /opt/tome/docker/bake-deps.sh
COPY docker/lib/lockfile-hash.sh docker/lib/imp-symlink.sh /opt/tome/docker/lib/
RUN chmod +x /opt/tome/docker/bake-deps.sh \
  && TOME_ROOT=/opt/tome IMP_ROOT=/opt/imp-ts IMP_GRAPH_VIEW_ROOT=/opt/imp-graph-view bash /opt/tome/docker/bake-deps.sh
# Source on top of the installed tree (sources has no node_modules, so nothing installed is replaced).
COPY --from=sources /opt/tome /opt/tome
COPY --from=sources /opt/imp-ts /opt/imp-ts
COPY --from=sources /opt/imp-graph-view /opt/imp-graph-view

FROM base AS release
RUN useradd --create-home --uid 1000 --shell /bin/bash tome \
  && mkdir -p /opt/tome /opt/tome-baked /opt/imp-ts /opt/imp-graph-view \
  && chown -R tome:tome /opt

COPY --from=deps --chown=tome:tome /opt/tome /opt/tome
COPY --from=deps --chown=tome:tome /opt/imp-ts /opt/imp-ts
COPY --from=deps --chown=tome:tome /opt/imp-graph-view /opt/imp-graph-view
COPY --from=deps --chown=tome:tome /opt/tome /opt/tome-baked

COPY --chown=tome:tome docker/ensure-deps-release.sh /opt/tome/scripts/ensure-node-modules.sh
COPY --chown=tome:tome docker/ensure-deps-release.sh /opt/tome-baked/scripts/ensure-node-modules.sh
COPY --chown=tome:tome docker/lib/lockfile-hash.sh docker/lib/imp-symlink.sh /opt/tome/docker/lib/
COPY --chown=tome:tome docker/lib/lockfile-hash.sh docker/lib/imp-symlink.sh /opt/tome-baked/docker/lib/
COPY docker/entrypoint-release.sh /usr/local/bin/tome-entrypoint
RUN chmod +x /usr/local/bin/tome-entrypoint \
  /opt/tome/scripts/ensure-node-modules.sh \
  /opt/tome-baked/scripts/ensure-node-modules.sh

USER tome
ENV HOME=/home/tome
ENV BUN_INSTALL=/usr/local/bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"
ENV TOME_ROOT=/opt/tome
ENV TOME_BAKED_ROOT=/opt/tome-baked
ENV IMP_ROOT=/opt/imp-ts
ENV IMP_GRAPH_VIEW_ROOT=/opt/imp-graph-view
ENV TOME_EDITOR_DEV_HOST=0.0.0.0
WORKDIR /opt/tome

EXPOSE 3847 5173
ENTRYPOINT ["/usr/local/bin/tome-entrypoint"]
CMD ["serve-dev"]
