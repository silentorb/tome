# syntax=docker/dockerfile:1
# Dev image: toolchain for workbench / agent iteration.
# Runtime bun install via bind-mounted source + tome-node-modules volume.
# Build: docker build -f docker/Dockerfile.dev -t tome-dev:local .
FROM mcr.microsoft.com/devcontainers/base:debian

USER root

RUN <<EOF
mkdir -p /workspaces/dev /workspaces/build
chown vscode:vscode /workspaces/dev /workspaces/build
EOF

ENV BUN_INSTALL=/usr/local/bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"
ENV DEBIAN_FRONTEND=noninteractive

COPY docker/install-runtime.sh /tmp/install-runtime.sh
RUN bash /tmp/install-runtime.sh && rm /tmp/install-runtime.sh

USER vscode
CMD ["sleep", "infinity"]
