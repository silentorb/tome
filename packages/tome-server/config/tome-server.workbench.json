{
  "version": 2,
  "dataStores": {
    "marloth": {
      "id": "marloth",
      "module": "tome-flatfile",
      "export": "createFlatfileModule",
      "options": {
        "contentPath": "/workspaces/marloth-story/content",
        "access": "readwrite"
      }
    },
    "session-cache": {
      "id": "session-cache",
      "module": "tome-sqlite",
      "export": "createSqliteModule",
      "options": {
        "dbPath": "/workspaces/marloth-story/data/tome.sqlite"
      }
    },
    "fts": {
      "id": "fts",
      "module": "tome-search-sqlite",
      "export": "createSearchSqliteModule",
      "options": {
        "dbPath": "/workspaces/marloth-story/data/tome-fts.sqlite"
      }
    }
  },
  "sync": {
    "queryStoreId": "session-cache",
    "graph": {
      "nodes": [
        {
          "id": "git:marloth",
          "type": "tome.sync.gitWatch",
          "inputs": {
            "storeId": "marloth"
          }
        },
        {
          "id": "sink:session-cache",
          "type": "tome.sync.store",
          "inputs": {
            "storeId": "session-cache"
          }
        },
        {
          "id": "sink:fts",
          "type": "tome.sync.store",
          "inputs": {
            "storeId": "fts"
          }
        }
      ],
      "edges": [
        {
          "id": "obs:marloth->cache",
          "from": {
            "node": "git:marloth",
            "port": "observeOut"
          },
          "to": {
            "node": "sink:session-cache",
            "port": "observeIn"
          }
        },
        {
          "id": "obs:marloth->fts",
          "from": {
            "node": "git:marloth",
            "port": "observeOut"
          },
          "to": {
            "node": "sink:fts",
            "port": "observeIn"
          }
        }
      ]
    }
  },
  "authorization": {
    "implementationId": "allow-everything"
  },
  "services": [
    {
      "id": "http",
      "module": "tome-http",
      "export": "createTomeHttpService",
      "options": {
        "port": 3847
      }
    }
  ]
}
