---
import "../lib/bare-layout.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
  </head>
  <body class="site-layout--bare">
    <main class="page page--bare">
      <slot />
    </main>
  </body>
</html>
