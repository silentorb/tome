---
import BareLayout from "../../layouts/BareLayout.astro";
import NodeLayout from "../../layouts/NodeLayout.astro";
import NodePage from "../../components/NodePage.astro";
import { createSiteUrlResolver, getSiteBase, loadAllNodes, titleByIdRecord } from "../../lib/content";
import { resolvePageTitleAndContent } from "../../lib/markdown";
import { isBareLayout, resolveNodeLayout } from "../../lib/page-layout";

export function getStaticPaths() {
  const titleById = titleByIdRecord();
  return loadAllNodes().map((node) => ({
    params: { slug: node.urlPath ?? node.id },
    props: { node, titleById },
  }));
}

interface Props {
  node: import("../../lib/site-types").SiteNode;
  titleById: Record<string, string>;
}

const { node, titleById } = Astro.props;
const base = getSiteBase();
const urls = createSiteUrlResolver();
const { title } = resolvePageTitleAndContent(node.body, node.title);
const layout = resolveNodeLayout(node);
const Layout = isBareLayout(layout) ? BareLayout : NodeLayout;
---

<Layout title={title}>
  <NodePage node={node} base={base} titleById={titleById} urls={urls} layout={layout} />
</Layout>
