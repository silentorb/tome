---
import BareLayout from "../layouts/BareLayout.astro";
import NodeLayout from "../layouts/NodeLayout.astro";
import NodePage from "../components/NodePage.astro";
import {
  createSiteUrlResolver,
  getHomeNodeId,
  getSiteBase,
  loadNodeById,
  titleByIdRecord,
} from "../lib/content";
import { resolvePageTitleAndContent } from "../lib/markdown";
import { isBareLayout, resolveNodeLayout } from "../lib/page-layout";

const homeId = getHomeNodeId();
const home = loadNodeById(homeId);
if (!home) throw new Error(`Home node not found: ${homeId}`);

const base = getSiteBase();
const urls = createSiteUrlResolver();
const { title } = resolvePageTitleAndContent(home.body, home.title);
const layout = resolveNodeLayout(home);
const Layout = isBareLayout(layout) ? BareLayout : NodeLayout;
---

<Layout title={title}>
  <NodePage
    node={home}
    base={base}
    titleById={titleByIdRecord()}
    urls={urls}
    layout={layout}
  />
</Layout>
